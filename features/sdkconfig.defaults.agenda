# Enabled by `build.py --with agenda` (see docs/FEATURE_FLAGS_PLAN.md).
# Feature-specific sdkconfig lines belong in this file.
CONFIG_FEATURE_AGENDA=y

# Cross-signed roots: calendar.google.com's chain ends at "GTS Root R4", which is
# cross-signed by the older GlobalSign root the certificate bundle trusts. Without this
# option a Google Calendar ICS fetch fails with "No matching trusted root certificate".
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
