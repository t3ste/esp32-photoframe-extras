# Enabled by `build.py --with https` (see docs/FEATURE_FLAGS_PLAN.md).
# Feature-specific sdkconfig lines belong in this file.
CONFIG_FEATURE_HTTPS=y

# esp_https_server plus the mbedTLS options its on-device self-signed certificate needs.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y

# HTTP (10) + HTTPS (4) server sockets, their listen sockets and outgoing connections.
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MAX_ACTIVE_TCP=24

# TLS session buffers from malloc() (PSRAM), see sdkconfig.defaults.fixes.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
