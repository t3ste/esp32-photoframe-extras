# Enabled by `build.py --with fixes` (see docs/FEATURES.md).
# Feature-specific sdkconfig lines belong in this file.
CONFIG_FORK_FIXES=y

# All sockets share one lwIP pool: HTTP server (10) + listen/control sockets + outgoing
# connections (weather, OTA, ...). With 16 the pool ran dry as soon as a browser held
# many keep-alive connections (httpd 'error in accept (23)' == ENFILE).
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MAX_ACTIVE_TCP=24

# mbedTLS: allocate through malloc() so the 16 KiB + 4 KiB TLS buffers can go to PSRAM
# instead of failing with -0x008D (out of memory) once internal RAM is fragmented.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# Optimise for size instead of the IDF default (-Og): the app is 5% smaller (168 KB on the Waveshare
# build with every feature) and the 3.5 MiB update slots of the boards with internal flash have no room to
# spare. Assertion texts and the log levels stay as they are.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
